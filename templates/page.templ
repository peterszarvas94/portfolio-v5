package templates

templ Page() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Péter Szarvas. From systems administration to full-stack development. Building simple software that works."/>
			<title>Péter Szarvas</title>
			<meta name="color-scheme" content="light"/>
			<link rel="canonical" href="https://peterszarvas.hu/"/>
			<link rel="icon" href="/favicon.ico" sizes="32x32"/>
			<link rel="icon" type="image/svg+xml" href={ templ.SafeURL(faviconHref()) }/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
			<meta property="og:type" content="website"/>
			<meta property="og:url" content="https://peterszarvas.hu/"/>
			<meta property="og:title" content="Péter Szarvas"/>
			<meta property="og:description" content="I build web applications."/>
			<meta property="og:image" content="https://peterszarvas.hu/static/brand/og.png"/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:image:alt" content="Péter Szarvas: I build web applications."/>
			<meta name="twitter:card" content="summary_large_image"/>
			<link rel="preload" href="/static/fonts/IBMPlexMono-Regular.ttf" as="font" type="font/ttf" crossorigin/>
			<link rel="stylesheet" href={ templ.SafeURL(Stylesheet) }/>
			<script type="module" src={ Script }></script>
		</head>
		<body>
			<a class="skip-link" href="#content">Skip to content</a>
			<nav class="page-nav" aria-label="Resume">
				<div class="resume-actions">
					<a class="btn btn-amber" href="/resume.pdf" download="Peter-Szarvas-resume.pdf">Save resume <span aria-hidden="true">↓</span></a>
					<button type="button" class="btn" onclick="document.fonts.ready.then(() => window.print())">Print resume</button>
				</div>
			</nav>
			<main id="content" class="paper">
				<header class="identity">
					<div class="name-row">
						<h1>Péter Szarvas</h1>
						<p class="aside">Martonvásár, HUN</p>
					</div>
					<p class="intro">I build web applications.</p>
					<address>
						<a href="mailto:contact@peterszarvas.hu">contact@peterszarvas.hu</a>
						<a href="https://github.com/peterszarvas94" target="_blank" rel="noopener">github.com/peterszarvas94</a>
						<a href="https://www.linkedin.com/in/peterszarvas94/" target="_blank" rel="noopener">linkedin.com/in/peterszarvas94</a>
					</address>
				</header>
				@Career()
				<div class="home-extra">
					<section class="lore" aria-labelledby="lore-heading">
						<h2 id="lore-heading">Who am I?</h2>
						<p>I like computers. I want to understand how they work and put them to use wherever I can: building servers and apps, running my homelab, using Linux. Mostly because I love tinkering.</p>
						<p>I've built with a lot of technologies. These days I stick to simple, powerful tools: Go or Rails, hypermedia libraries like htmx and Datastar, server-rendered apps, plain CSS and JavaScript. I've had my share of frameworks too, like React, Next.js and Astro.</p>
						<p>These days I am experimenting with self-hosting and running local LLMs.</p>
						<p>A few good books I picked up along the way:</p>
						<ul class="reading-list">
							<li><a href="https://hypermedia.systems/" target="_blank" rel="noopener">Hypermedia Systems</a></li>
							<li><a href="https://grugbrain.dev/" target="_blank" rel="noopener">The Grug Brained Developer</a></li>
							<li><a href="https://www.oreilly.com/library/view/we-programmers-a/9780135344248/" target="_blank" rel="noopener">We, Programmers</a></li>
							<li><a href="https://basecamp.com/books#rework" target="_blank" rel="noopener">Rework</a></li>
						</ul>
					</section>
					<footer><p>Building is fun, and I don't plan to stop. Maybe I can build something for you? <a class="btn btn-green" href="mailto:contact@peterszarvas.hu">Let's talk!</a></p></footer>
				</div>
			</main>
			<div class="colophon">
				<button type="button" class="btn sheet-toggle" aria-controls="typesheet" aria-expanded="false">
					<span class="lamp" aria-hidden="true"></span>Spec sheet
				</button>
				<div class="version-picker">
					<select class="version-select" aria-label="Site version">
						<option value="" selected>v5-2026</option>
						<option value="https://v4.peterszarvas.hu">v4-2026</option>
						<option value="https://v3.peterszarvas.hu">v3-2026</option>
						<option value="https://v2.peterszarvas.hu">v2-2023</option>
						<option value="https://v1.peterszarvas.hu">v1-2021</option>
					</select>
				</div>
			</div>
			@TypeSheet()
		</body>
	</html>
}

templ Rail() {
	<span class="rail" aria-hidden="true"></span>
}

templ Career() {
	<ol class="career" aria-label="My path">
		<li class="stage">
			<h2>Full-Stack Developer</h2>
			<div class="stage-body">
				@Rail()
				<div class="jobs">
					<section class="job" aria-labelledby="eviden-heading">
						<header class="job-head"><h3 id="eviden-heading">Eviden / Atos <span class="badge"><span class="lamp" aria-hidden="true"></span>Current</span></h3><p class="dates"><time datetime="2024">2024</time>–present</p></header>
						<ul><li>Developing a new public-sector web application in an international team of 10+.</li><li>Building reusable UI components and REST API endpoints.</li><li><span class="label">Tech stack:</span> React, TypeScript, Material UI, Node.js, NestJS, OpenAPI, Vitest.</li></ul>
					</section>
					<section class="job" aria-labelledby="kyndryl-heading">
						<header class="job-head"><h3 id="kyndryl-heading">Kyndryl</h3><p class="dates"><time datetime="2022">2022</time>–<time datetime="2024">2024</time></p></header>
						<ul><li>Developed and maintained an internal lead-tracking application, as one of two developers.</li><li><span class="label">Tech stack:</span> React, JavaScript.</li></ul>
					</section>
				</div>
			</div>
		</li>
		<li class="stage">
			<h2>System Administrator</h2>
			<div class="stage-body">
				@Rail()
				<div class="jobs">
					<section class="job" aria-labelledby="ibm-heading">
						<header class="job-head"><h3 id="ibm-heading">IBM / Kyndryl</h3><p class="dates"><time datetime="2020">2020</time>–<time datetime="2022">2022</time></p></header>
						<ul><li>Deployed and maintained Windows Server infrastructure across hybrid on-premises and Microsoft Azure environments, handling L2 and L3 escalations.</li><li>Earned the Microsoft Azure Fundamentals (AZ-900) and Azure Administrator Associate (AZ-104, now expired) certifications.</li></ul>
					</section>
				</div>
			</div>
		</li>
		<li class="stage">
			<h2>AI-Assisted Solo Developer</h2>
			<p class="aside stage-note">Designed, built, deployed and maintained end to end.</p>
			<div class="stage-body">
				@Rail()
				<div class="jobs">
					<section class="job" aria-labelledby="bandcash-heading">
						<header class="job-head"><h3 id="bandcash-heading">Bandcash <span class="badge"><span class="lamp" aria-hidden="true"></span>Current</span></h3><p class="dates"><time datetime="2026">2026</time>–present</p><p class="site"><a href="https://bandcash.app" target="_blank" rel="noopener">bandcash.app</a></p></header>
						<ul><li>A payment-splitting app for music bands, running in production.</li><li><span class="label">Tech stack:</span> Go, templ, Datastar, SQLite.</li></ul>
					</section>
					<section class="job" aria-labelledby="pongrac-heading">
						<header class="job-head"><h3 id="pongrac-heading">Szarvas Pongrác</h3><p class="dates"><time datetime="2025">2025</time></p><p class="site"><a href="https://szarvaspongrac.hu" target="_blank" rel="noopener">szarvaspongrac.hu</a></p></header>
						<ul><li>Portfolio site for a visual artist.</li><li><span class="label">Tech stack:</span> Go, templ, Datastar, PocketBase, Tailwind CSS.</li></ul>
					</section>
					<section class="job" aria-labelledby="szeremle-heading">
						<header class="job-head"><h3 id="szeremle-heading">Szeremlei Néptáncegyüttes</h3><p class="dates"><time datetime="2023">2023</time></p><p class="site"><a href="https://szeremletanc.hu" target="_blank" rel="noopener">szeremletanc.hu</a></p></header>
						<ul><li>Website for a folk dance group.</li><li><span class="label">Tech stack:</span> Astro, WordPress (headless).</li></ul>
					</section>
					<section class="job" aria-labelledby="pantlika-heading">
						<header class="job-head"><h3 id="pantlika-heading">Pántlika Zenekar</h3><p class="dates"><time datetime="2022">2022</time></p><p class="site"><a href="https://pantlikazenekar.hu" target="_blank" rel="noopener">pantlikazenekar.hu</a></p></header>
						<ul><li>Website for a folk music band.</li><li><span class="label">Tech stack:</span> Astro.</li></ul>
					</section>
					<section class="job" aria-labelledby="wedding-heading">
						<header class="job-head"><h3 id="wedding-heading">Wedding invitation</h3><p class="dates"><time datetime="2022">2022</time></p><p class="site"><a href="https://wedding.peterszarvas.hu" target="_blank" rel="noopener">wedding.peterszarvas.hu</a></p></header>
						<ul><li>A small website for a big day.</li><li><span class="label">Tech stack:</span> TypeScript, Vite.</li></ul>
					</section>
					<div class="job next"><p><a class="btn btn-amber" href="mailto:contact@peterszarvas.hu">Your project here?</a></p><ul><li>Something nice and useful, built together.</li></ul></div>
				</div>
			</div>
		</li>
	</ol>
}
